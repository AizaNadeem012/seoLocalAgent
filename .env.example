# LinkForge Environment Configuration Example
# Copy this file to .env and fill in your details

# Gmail SMTP & IMAP Outreach (Requires 16-digit App Password from Google Account)
GMAIL_ADDRESS=your-email@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# OpenAI API Key (Optional — used for AI pitch & article generation)
OPENAI_API_KEY=sk-proj-your-openai-api-key-here
